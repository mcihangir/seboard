            (pt 0 0)
            (width 185000)
            (height 312500)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r130_55
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r130_55))
          (noconnect (pad r130_55))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r130_55))
          (noconnect (pad r130_55))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r130_55))
          (noconnect (pad r130_55))
        )
      )
      (padstack r147.5_80
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r147.5_80))
          (noconnect (pad r147.5_80))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r147.5_80))
          (noconnect (pad r147.5_80))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r147.5_80))
          (noconnect (pad r147.5_80))
        )
      )
      (padstack r312.5_185
