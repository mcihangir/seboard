        (padSet (footLayer MetalMask-Top)
          (connect (pad r312.5_185))
          (noconnect (pad r312.5_185))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "AP2204R50TRG1"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
